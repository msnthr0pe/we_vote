<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:layout_marginHorizontal="8dp"
    android:layout_marginBottom="2dp"
    app:cardCornerRadius="20dp"
    app:cardBackgroundColor="#01292B"
    app:cardElevation="2dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/voting_card_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/default_recycler_text"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:fontFamily="@font/montserrat_regular"
            android:textAlignment="textStart"
            android:lineSpacingMultiplier="1" />

        <!-- Unvoted state: Participate button + admin archive button -->
        <LinearLayout
            android:id="@+id/vote_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="12dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/vote_btn"
                android:layout_width="wrap_content"
                android:layout_height="50dp"
                android:paddingHorizontal="16dp"
                android:text="@string/vote"
                android:textColor="#011314"
                android:fontFamily="@font/montserrat_medium"
                android:backgroundTint="#AEAF50"
                android:textSize="16sp"
                app:cornerRadius="20dp"
                app:strokeWidth="0dp" />

            <ImageButton
                android:id="@+id/voting_archive_btn"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_cancel_red"
                android:scaleType="centerInside"
                android:clickable="true"
                android:focusable="true"
                android:visibility="gone"
                android:contentDescription="@string/end_survey" />

        </LinearLayout>

        <!-- Voted state: already voted label + results button + bars -->
        <LinearLayout
            android:id="@+id/voted_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="8dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/already_voted_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/already_voted"
                android:textColor="#80FFFFFF"
                android:textSize="14sp"
                android:fontFamily="@font/montserrat_extralightitalic" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/current_results_btn"
                android:layout_width="wrap_content"
                android:layout_height="50dp"
                android:layout_marginTop="8dp"
                android:paddingHorizontal="16dp"
                android:text="@string/current_results"
                android:textColor="@color/neon"
                android:fontFamily="@font/montserrat_medium"
                android:backgroundTint="@color/light_green"
                android:textSize="15sp"
                app:cornerRadius="20dp"
                app:strokeColor="@color/neon"
                app:strokeWidth="0.5dp" />

            <LinearLayout
                android:id="@+id/results_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="12dp"
                android:visibility="gone">

                <com.example.we_vote.RelationBar
                    android:id="@+id/result_bar_1"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    app:progressColor="@color/neon"
                    app:strokeWidth="0.5dp"/>

                <com.example.we_vote.RelationBar
                    android:id="@+id/result_bar_2"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="12dp"
                    app:progressColor="@color/neon"
                    app:strokeWidth="0.5dp"/>

                <com.example.we_vote.RelationBar
                    android:id="@+id/result_bar_3"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="12dp"
                    app:progressColor="@color/neon"
                    app:strokeWidth="0.5dp"/>

            </LinearLayout>

        </LinearLayout>


    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
