<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:background="#011314"
    android:paddingTop="44dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/new_requests"
        android:textColor="@color/white"
        android:textSize="@dimen/titleTextSize"
        android:fontFamily="@font/montserrat_semibold" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingHorizontal="12dp"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="4dp">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/filter_chip_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleSelection="true"
            app:singleLine="true"
            app:chipSpacingHorizontal="8dp">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_pending"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="@string/filter_new"
                android:textColor="@color/dark"
                android:fontFamily="@font/montserrat_medium"
                android:textSize="13sp"
                android:checked="true"
                app:chipBackgroundColor="@color/chip_background"
                app:chipStrokeColor="@color/chip_stroke"
                app:chipStrokeWidth="1dp"
                app:chipCornerRadius="18dp"
                app:checkedIconVisible="false"
                app:chipIconVisible="false"
                app:ensureMinTouchTargetSize="false" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_accepted"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="@string/filter_accepted"
                android:textColor="@color/dark"
                android:fontFamily="@font/montserrat_medium"
                android:textSize="13sp"
                app:chipBackgroundColor="@color/chip_background"
                app:chipStrokeColor="@color/chip_stroke"
                app:chipStrokeWidth="1dp"
                app:chipCornerRadius="18dp"
                app:checkedIconVisible="false"
                app:chipIconVisible="false"
                app:ensureMinTouchTargetSize="false" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_rejected"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="@string/filter_rejected"
                android:textColor="@color/dark"
                android:fontFamily="@font/montserrat_medium"
                android:textSize="13sp"
                app:chipBackgroundColor="@color/chip_background"
                app:chipStrokeColor="@color/chip_stroke"
                app:chipStrokeWidth="1dp"
                app:chipCornerRadius="18dp"
                app:checkedIconVisible="false"
                app:chipIconVisible="false"
                app:ensureMinTouchTargetSize="false" />

        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_new_applications"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            tools:listitem="@layout/item_application" />

        <TextView
            android:id="@+id/empty_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/nothing_found"
            android:textColor="@color/white_50"
            android:textSize="16sp"
            android:fontFamily="@font/montserrat_regular"
            android:visibility="gone" />

    </FrameLayout>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="#01292B"
        app:itemIconSize="20dp"
        app:itemIconTint="@color/white"
        app:menu="@menu/menu_bottom_nav_admin"
        app:itemRippleColor="@android:color/transparent"
        app:labelVisibilityMode="unlabeled"
        android:layout_gravity="bottom" />

</LinearLayout>
