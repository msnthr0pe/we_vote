<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/back">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingTop="44dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/new_survey"
            android:textColor="@color/white"
            android:textSize="@dimen/titleTextSize"
            android:fontFamily="@font/montserrat_semibold" />

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/mediumLayoutPadding"
                android:gravity="center">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/light_green"
                    app:cardCornerRadius="20dp"
                    app:strokeWidth="0dp"
                    android:layout_marginVertical="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/survey_contents"
                            android:layout_marginBottom="10dp"
                            android:layout_gravity="center"
                            android:textSize="16sp"
                            android:fontFamily="@font/montserrat_medium"
                            android:textColor="@color/white"/>

                        <EditText
                            android:id="@+id/new_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:lines="4"
                            android:maxLines="4"
                            android:textColor="@color/white"
                            android:textColorHint="@color/white_50"
                            android:backgroundTint="@color/light_green_2" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/choice"
                            android:textSize="16sp"
                            android:fontFamily="@font/montserrat_medium"                            android:layout_marginTop="20dp"
                            android:layout_marginBottom="10dp"
                            android:layout_gravity="center"
                            android:textColor="@color/white"/>

                        <EditText
                            android:id="@+id/new_first_choice"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/white"
                            android:textColorHint="@color/white_50"
                            android:backgroundTint="@color/light_green_2"
                            android:singleLine="true"
                            android:maxLines="1"
                            android:layout_marginBottom="10dp"/>

                        <EditText
                            android:id="@+id/new_second_choice"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/white"
                            android:textColorHint="@color/white_50"
                            android:backgroundTint="@color/light_green_2"
                            android:singleLine="true"
                            android:maxLines="1"
                            android:layout_marginBottom="10dp"/>

                        <EditText
                            android:id="@+id/new_third_choice"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/white"
                            android:textColorHint="@color/white_50"
                            android:backgroundTint="@color/light_green_2"
                            android:singleLine="true"
                            android:maxLines="1" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <Button
                    android:id="@+id/add_survey_btn"
                    android:layout_width="wrap_content"
                    android:layout_height="54dp"
                    app:strokeWidth="0dp"
                    android:layout_gravity="center"
                    android:layout_marginBottom="18dp"
                    android:backgroundTint="#AEAF50"
                    android:fontFamily="@font/montserrat_semibold"
                    android:text="@string/publish"
                    android:textColor="#011314"
                    android:textSize="18sp"/>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottom_nav"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="#01292B"
            app:itemIconSize="20dp"
            app:itemIconTint="@color/white"
            app:menu="@menu/menu_bottom_nav_user"
            app:itemRippleColor="@android:color/transparent"
            app:labelVisibilityMode="unlabeled"
            android:layout_gravity="bottom"/>

    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleLarge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminate="true"
        android:indeterminateTint="?attr/colorPrimary"
        android:visibility="gone"
        android:background="@android:color/transparent" />

</FrameLayout>
